# ============================================
# 服务器配置
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=14

# ============================================
# 数据库配置
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# API 配置
# ============================================
API_BASE_URL=http://localhost:3000

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info

# ============================================
# Sentry 错误监控
# ============================================
SENTRY_DSN=

# ============================================
# 短信验证配置
# ============================================
VERIFICATION_EXPIRY_MINUTES=5
MAX_VERIFICATION_ATTEMPTS=5
MAX_VERIFY_ATTEMPTS=3
ENABLE_REAL_SMS=false
VERIFICATION_RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Apple IAP 配置
# ============================================
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=com.yourcompany.dozoo

# ============================================
# 微信开放平台配置（微信登录）
# ============================================
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret

# ============================================
# 微信支付配置
# ============================================
WECHAT_MCH_ID=1234567890
WECHAT_API_KEY=your_wechat_api_key
WECHAT_ENV=sandbox
WECHAT_PAY_API=https://api.mch.weixin.qq.com
WECHAT_PAY_SANDBOX_API=https://api.mch.weixin.qq.com/sandboxnew

# ============================================
# Apple Pay 配置
# ============================================
APPLE_PAY_MERCHANT_ID=merchant.com.modoo
APPLE_PAY_DISPLAY_NAME=Modoo
APPLE_PAY_COUNTRY_CODE=CN
APPLE_PAY_CURRENCY_CODE=CNY
APPLE_PAY_API_URL=https://apple-pay-gateway.apple.com
