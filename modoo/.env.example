# ============================================
# 应用版本配置
# ============================================
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=2026.05.01
EXPO_PUBLIC_ENV=development

# ============================================
# API 配置
# ============================================
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_API_RETRIES=3
EXPO_PUBLIC_API_RETRY_DELAY=1000
EXPO_PUBLIC_API_MAX_REFRESH_RETRIES=1

# ============================================
# CDN 配置
# ============================================
EXPO_PUBLIC_CDN_URL=https://cdn.modoo.baby

# ============================================
# 认证配置
# ============================================
EXPO_PUBLIC_AUTH_TOKEN_EXPIRY_BUFFER=1800000
EXPO_PUBLIC_AUTH_SESSION_TIMEOUT=604800000
EXPO_PUBLIC_AUTH_CHECK_INTERVAL=300000
EXPO_PUBLIC_AUTH_ACTIVITY_THROTTLE=60000

# ============================================
# 国际化配置
# ============================================
EXPO_PUBLIC_I18N_DEFAULT_LANG=zh-CN

# ============================================
# 微信开放平台配置
# ============================================
WECHAT_APP_ID=wx1234567890abcdef
